@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(UNIX)
    # The connection pool uses pthreads; a static libhotkv links Threads::Threads.
    set(THREADS_PREFER_PTHREAD_FLAG ON)
    find_dependency(Threads)
endif()
if(@HOTKV_WITH_SSL@)
    find_dependency(OpenSSL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hotkvTargets.cmake")
check_required_components(hotkv)
